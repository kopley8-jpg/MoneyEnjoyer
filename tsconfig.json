{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "skipLibCheck": true,
    "types": ["jest"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@app/*": ["src/app/*"],
      "@screens/*": ["src/screens/*"],
      "@entities/": ["src/entities"],
      "@features/":["src/features"],
      "@widgets/":["src/widgets"],
      "@shared/*": ["src/shared/*"],

    },

  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
